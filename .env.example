# Model provider (any OpenAI-compatible endpoint)
DARWIN_LLM_BASE_URL=https://api.openai.com/v1
DARWIN_LLM_API_KEY=sk-...
DARWIN_LLM_MODEL=gpt-4o-mini

---
# Optional: Neo4j. Leave unset to use the local docker-compose instance.
# To skip the JVM overhead locally, use a free Neo4j Aura instance instead
# (aura dsn looks like: neo4j+s://<hash>.databases.neo4j.io)
# DARWIN_NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
# DARWIN_NEO4J_USER=neo4j
# DARWIN_NEO4J_PASSWORD=<your-aura-password>
