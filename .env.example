# ---- Model provider (any OpenAI-compatible endpoint) ----
DARWIN_LLM_BASE_URL=https://api.openai.com/v1
DARWIN_LLM_API_KEY=sk-...
DARWIN_LLM_MODEL=gpt-4o-mini

# ---- MCP web servers (optional; without them those servers are skipped) ----
# FIRECRAWL_API_KEY=fc-...
# EXA_API_KEY=...

# ---- Services (defaults match docker-compose.yml, so usually leave these unset) ----
# POSTGRES_URL=postgresql://darwin:darwin@localhost:5432/darwin
# QDRANT_URL=http://localhost:6333
# REDIS_URL=redis://localhost:6379/0

# ---- Neo4j (optional) ----
# Leave unset to use the local docker-compose instance (neo4j/darwin123).
# To skip the JVM overhead locally, use a free Neo4j Aura instance instead.
# NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=<your-aura-password>

# ---- Permission boundary (optional) ----
# WORKSPACE_ROOT=/absolute/path/to/workspace   # default: current directory
# PERMISSIONS_PATH=permissions.json            # allow / ask / deny rules

# ---- MCP subsystem (optional) ----
# MCP_CONFIG_PATH=mcp.json
# MCP_SERVER_COMMAND=                          # override the interpreter for .py MCP servers
# TOOL_RAG_ENABLED=true                        # mask MCP tools per turn via Qdrant
# TOOL_RAG_TOP_K=12
# READ_ONLY_MCP_TOOLS=get_current_time,convert_time,fetch,...   # MCP tools that skip HITL approval
