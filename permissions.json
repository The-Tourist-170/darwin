{
  "permissions": {
    "allow": [
      "Bash(docker ps*)",
      "Bash(docker logs*)",
      "Bash(docker compose ps*)",
      "Bash(docker images*)",
      "Bash(docker inspect*)"
    ],
    "ask": [
      "Bash(sudo *)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.darwin/**)",
      "Bash(sudo rm*)"
    ]
  }
}
